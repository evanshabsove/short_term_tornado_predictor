# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*

# Data (keep directory structure, ignore contents)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
# Live forecast archive written by the scheduler (issued forecasts are the verification record)
data/live/*
!data/live/.gitkeep
*.grib2
*.grib2.*.idx
*.nc
*.nc4
*.h5
*.parquet

# Trained model weights (regenerable via scripts/03_architecture_search/train_model.py)
models/*
!models/.gitkeep
# The production bundle's small provenance file (member hashes, recipe, training data) is tracked;
# the checkpoints themselves stay ignored via *.pt below.
!models/production/
models/production/*
!models/production/manifest.json
# The tier study's results (serving cutoffs + tier_set_id the API reads) are small and tracked.
!models/tiers/
models/tiers/*
!models/tiers/tier_study.json
*.pt
*.pth

# Generated visualizations (regenerable via scripts/03_architecture_search/run_inference.py etc.)
outputs/*
!outputs/.gitkeep

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp

# Testing / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
